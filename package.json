{
  "name": "weather",
  "version": "0.0.0",
  "private": true,
  "description": "Installable weather instrument PWA for Android / GrapheneOS",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
